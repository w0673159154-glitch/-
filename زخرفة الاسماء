<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>زخرفة الأسماء</title>

<style>
body{
font-family:Arial;
background:#f5f5f5;
text-align:center;
padding:20px;
}
h1{
color:#333;
}
input{
width:90%;
max-width:350px;
padding:12px;
font-size:18px;
border-radius:10px;
border:1px solid #ccc;
}
button{
padding:12px 20px;
margin-top:10px;
font-size:18px;
border:none;
border-radius:10px;
background:#2196F3;
color:white;
}
.result{
margin-top:20px;
background:white;
padding:15px;
border-radius:10px;
font-size:22px;
}
</style>
</head>

<body>

<h1>✨ زخرفة الأسماء ✨</h1>

<input id="name" placeholder="اكتب اسمك">

<br>

<button onclick="decorate()">زخرف</button>

<div class="result" id="result"></div>

<script>

function decorate(){

let n=document.getElementById("name").value;

let list=[
"★"+n+"★",
"꧁"+n+"꧂",
"♛"+n+"♛",
"✿"+n+"✿",
"『"+n+"』",
"◥"+n+"◤",
"彡"+n+"彡",
"๖"+n+"๖",
"✧"+n+"✧",
"♥"+n+"♥"
];

document.getElementById("result").innerHTML=list.join("<br><br>");

}

</script>

</body>
</html>
